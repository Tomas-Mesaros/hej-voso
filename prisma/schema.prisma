// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./database.sqlite"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model BandMember {
  id           Int      @id @default(autoincrement())
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  stageName    String?  @map("stage_name")
  role         String?
  bio          String?
  photo        String?
  email        String?
  phone        String?
  facebookUrl  String?  @map("facebook_url")
  instagramUrl String?  @map("instagram_url")
  youtubeUrl   String?  @map("youtube_url")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("band_members")
}

model Album {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  coverImage  String?  @map("cover_image")
  releaseDate DateTime? @map("release_date")
  genre       String?
  isPublished Boolean  @default(true) @map("is_published")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  songs Song[]

  @@map("albums")
}

model Song {
  id          Int      @id @default(autoincrement())
  albumId     Int      @map("album_id")
  title       String
  filename    String?
  duration    Int?
  trackNumber Int?     @map("track_number")
  lyrics      String?
  youtubeUrl  String?  @map("youtube_url")
  spotifyUrl  String?  @map("spotify_url")
  isPublished Boolean  @default(true) @map("is_published")
  playCount   Int      @default(0) @map("play_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  plays SongPlay[]

  @@map("songs")
}

model GalleryCategory {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  eventDate   String?  @map("event_date")
  coverPhoto  String?  @map("cover_photo")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  photos GalleryPhoto[]

  @@map("gallery_categories")
}

model GalleryPhoto {
  id         Int      @id @default(autoincrement())
  categoryId Int      @map("category_id")
  filename   String
  title      String?
  description String?
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category GalleryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("gallery_photos")
}

model Concert {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  image       String?
  eventDate   DateTime @map("event_date")
  eventTime   String?  @map("event_time")
  city        String
  venue       String
  address     String
  latitude    Float?
  longitude   Float?
  ticketUrl   String?  @map("ticket_url")
  ticketPrice Float?   @map("ticket_price")
  isPublished Boolean  @default(true) @map("is_published")
  isFeatured  Boolean  @default(false) @map("is_featured")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("concerts")
}

model PageView {
  id        Int      @id @default(autoincrement())
  page      String
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("page_views")
}

model SongPlay {
  id           Int      @id @default(autoincrement())
  songId       Int      @map("song_id")
  duration     Int      // v sekundách
  playedTime   Int      @map("played_time") // koľko sekúnd sa prehralo
  completed70  Boolean  @default(false) @map("completed_70") // či sa prehralo aspoň 70%
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("song_plays")
}
